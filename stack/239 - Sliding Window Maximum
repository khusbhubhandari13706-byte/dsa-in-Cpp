/*
-----------------------------------------
LeetCode 239 - Sliding Window Maximum
Pattern:Sliding Window + Monotonic Deque

Approach:
1. Use a deque to store indices of useful elements.
2. Remove indices that are outside the current window.
3. Remove elements from the back that are smaller
   than or equal to the current element.
4. Push the current index into the deque.
5. Once the window size reaches k, the front of the
   deque contains the maximum element.
6. Add nums[dq.front()] to the answer.

Time Complexity:O(n)
Space Complexity:O(k)

Key Learning:
- Store indices, not values.
- Deque maintains elements in decreasing order.
- The front always represents the maximum of the window.
-----------------------------------------
*/

class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        deque<int> dq;
        vector<int> ans;
        int n = nums.size();
        for(int i = 0; i < n; i++)
        {
            if(!dq.empty() && dq.front() <= i - k)
            {
                dq.pop_front();
            }
            while(!dq.empty() && nums[dq.back()] <= nums[i])
            {
                dq.pop_back();
            }
            dq.push_back(i);
            if(i >= k - 1)
            {
                ans.push_back(nums[dq.front()]);
            }
        }
        return ans;
    }
};
