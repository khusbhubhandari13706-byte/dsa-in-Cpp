/*
-----------------------------------------
LeetCode 316 - Remove Duplicate Letters

Pattern:Greedy + Monotonic Stack

Approach:
1. Store the frequency of every character.
2. Traverse the string and decrease its frequency.
3. If the character is already in the stack, skip it.
4. While the stack top is greater than the current
   character and appears again later, remove it.
5. Push the current character into the stack.
6. Reverse the stack to get the final answer.

Time Complexity:O(n)
Space Complexity:O(n)
-----------------------------------------
*/

class Solution {
public:
    string removeDuplicateLetters(string s) {

        vector<int> freq(26, 0);
        vector<bool> visited(26, false);

        for(char ch : s)
            freq[ch - 'a']++;

        stack<char> st;

        for(char ch : s)
        {
            freq[ch - 'a']--;

            if(visited[ch - 'a'])
                continue;

            while(!st.empty() &&
                  st.top() > ch &&
                  freq[st.top() - 'a'] > 0)
            {
                visited[st.top() - 'a'] = false;
                st.pop();
            }

            st.push(ch);
            visited[ch - 'a'] = true;
        }

        string ans = "";

        while(!st.empty())
        {
            ans += st.top();
            st.pop();
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
