/*-----------------------------------------
LeetCode 496 - Next Greater Element I
Pattern:Monotonic Decreasing Stack + Hash Map

Approach:
1. Traverse nums2 from right to left.
2. Maintain a monotonic decreasing stack.
3. Remove all elements smaller than or equal to the current element, as they can never be its next greater element.
4. If the stack becomes empty, the next greater element is -1; otherwise, the top of the stack is the answer.
5. Store the mapping of each element to its next greater element in a hash map.
6. Traverse nums1 and use the hash map to build the final answer.

Time Complexity:O(n + m)
where:
n = size of nums2
m = size of nums1

Space Complexity:O(n)

Key Learning:
- Monotonic Decreasing Stack efficiently finds the next greater element in linear time.
- Traverse from right to left because the next greater element always lies on the right side.
- Pop all smaller (or equal) elements since they cannot be the next greater element for any previous value.
- Use a hash map to answer queries for nums1 in O(1) time.

-----------------------------------------
*/

class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {

        unordered_map<int, int> mpp;
        stack<int> st;

        // Find next greater element for every element in nums2
        for(int i = nums2.size() - 1; i >= 0; i--)
        {
            while(!st.empty() && st.top() < nums2[i])
            {
                st.pop();
            }

            if(st.empty())
                mpp[nums2[i]] = -1;
            else
                mpp[nums2[i]] = st.top();

            st.push(nums2[i]);
        }

        vector<int> ans;

        // Build answer for nums1
        for(int x : nums1)
        {
            ans.push_back(mpp[x]);
        }

        return ans;
    }
};
