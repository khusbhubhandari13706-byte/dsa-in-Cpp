/*-----------------------------------------
LeetCode 155 - Min Stack
Pattern:Stack (Design)

Approach:
1. Use one stack to store all elements.
2. Use another stack to store the minimum elements.
3. While pushing, insert into the min stack if the new value is smaller than or equal to the current minimum.
4. While popping, remove from the min stack if the popped element is the current minimum.
5. The top of the min stack always stores the minimum element.

Time Complexity:
push()   : O(1)
pop()    : O(1)
top()    : O(1)
getMin() : O(1)

Space Complexity:O(n)
-----------------------------------------
*/
class MinStack {
public:
    stack<int>s1,s2;
    MinStack() {
        
    }
    
    void push(int value) {
        s1.push(value);
        if(s2.empty() || s2.top()>=value) s2.push(value);
    }
    
    void pop() {
        if(s1.top()==s2.top()) s2.pop();
        
        s1.pop();
        
    }
    
    int top() {
        return s1.top();
    }
    
    int getMin() {
        return s2.top();
    }
};

