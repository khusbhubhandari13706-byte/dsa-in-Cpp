/*
-----------------------------------------
LeetCode 232 - Implement Queue using Stacks

Pattern:Queue + Two Stacks

Approach:
1. Use two stacks: s1 and s2.
2. push() adds elements to s1.
3. For pop() and peek(), if s2 is empty,
   transfer all elements from s1 to s2.
4. This reverses the order and gives FIFO behavior.
5. empty() checks whether both stacks are empty.

Time Complexity:
push()  -> O(1)
pop()   -> O(1) amortized
peek()  -> O(1) amortized
empty() -> O(1)

Space Complexity:O(n)

Key Learning:
Two LIFO stacks can be combined to implement FIFO queue behavior.
-----------------------------------------
*/

class MyQueue {
public:
    stack<int> s1, s2;

    MyQueue() {
    }

    void push(int x) {
        s1.push(x);
    }

    int pop() {

        if(s2.empty())
        {
            while(!s1.empty())
            {
                s2.push(s1.top());
                s1.pop();
            }
        }

        int x = s2.top();
        s2.pop();

        return x;
    }

    int peek() {

        if(s2.empty())
        {
            while(!s1.empty())
            {
                s2.push(s1.top());
                s1.pop();
            }
        }

        return s2.top();
    }

    bool empty() {
        return s1.empty() && s2.empty();
    }
};
