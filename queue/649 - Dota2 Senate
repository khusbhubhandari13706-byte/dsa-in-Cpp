/*-----------------------------------------
LeetCode 649 - Dota2 Senate

Pattern:Queue + Simulation

Approach:
1. Maintain two queues for Radiant and Dire senators.
2. Store their indices in the respective queues.
3. Compare the front indices of both queues.
4. The senator with the smaller index bans the other.
5. The winning senator is added back with index + n
   for the next round.
6. Continue until one queue becomes empty.

Time Complexity:O(n)
Space Complexity:O(n)

Key Learning:
Using two queues of indices efficiently simulates the circular order of senators.
-----------------------------------------
*/

class Solution {
public:
    string predictPartyVictory(string senate) {
        int n=senate.size();
        queue<int>radiant;
        queue<int>dire;
        for(int i=0;i<n;i++)
        {
            if(senate[i]=='R') radiant.push(i);
            else dire.push(i);
        }
        while(!radiant.empty() && !dire.empty())
        {
            int r=radiant.front();
            radiant.pop();
            int d=dire.front();
            dire.pop();
            if(r<d)
            {
                radiant.push(r+n);
            }
            else
            {
                dire.push(d+n);
            }
        }
        if(!radiant.empty()) return "Radiant";
        else return "Dire";
    }
};
