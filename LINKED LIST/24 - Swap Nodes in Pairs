/*
-----------------------------------------
LeetCode 24 - Swap Nodes in Pairs
Pattern:Linked List + Pointer Manipulation

Approach:
1. Create a dummy node before the head.
2. Keep a prev pointer before each pair.
3. Store the first and second nodes of the pair.
4. Reverse their links to swap the two nodes.
5. Move prev to the first node and repeat.
6. Return dummy.next as the new head.

Time Complexity:O(n)
Space Complexity:O(1)

Key Learning:
A dummy node makes linked-list pointer manipulation easier, especially when the head itself changes.
-----------------------------------------
*/
class Solution {
public:
    ListNode* swapPairs(ListNode* head) {
        ListNode dummy(0);
        dummy.next=head;
        ListNode *prev=&dummy;
        while(prev->next!=NULL && prev->next->next!=NULL)
        {
            ListNode *first=prev->next;
            ListNode *sec=first->next;
            first->next=sec->next;
            sec->next=first;
            prev->next=sec;
            prev=first;
        }
        return dummy.next;
    }
};
