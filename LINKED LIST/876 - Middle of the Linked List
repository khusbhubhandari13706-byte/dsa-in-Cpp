/*
-----------------------------------------
LeetCode 876 - Middle of the Linked List
Pattern:Linked List + Fast & Slow Pointers

Approach:
1. Initialize slow and fast at the head.
2. Move slow one node at a time.
3. Move fast two nodes at a time.
4. When fast reaches the end, slow is at the middle.
5. Return slow.

For an even-length list, this returns the second middle node as required by the problem.

Time Complexity:O(n)
Space Complexity:O(1)

Key Learning:
The fast pointer moves twice as fast as the slow pointer, so when fast reaches the end, slow reaches the middle.

-----------------------------------------
*/
class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        ListNode*slow=head;
        ListNode*fast=head;
        while(fast!=NULL && fast->next!=NULL)
        {
            slow=slow->next;
            fast=fast->next->next;
        }
        return slow;
    }
};
