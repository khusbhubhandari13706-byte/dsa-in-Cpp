/*
-----------------------------------------
LeetCode 19 - Remove Nth Node From End of List
Pattern:Linked List + Length Calculation

Approach:
1. Traverse the list to calculate its length.
2. If n == length, remove the head.
3. Find the node just before the target node.
4. Skip the target node using:
   temp->next = temp->next->next
5. Return the updated head.

Time Complexity:O(n)
Space Complexity:O(1)

Key Learning:
The nth node from the end can be located using the total length of the linked list.
-----------------------------------------
*/


class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int length=0;
        ListNode *temp=head;
        while(temp!=NULL)
        {
            temp=temp->next;
            length++;
        }
        if(length==n)
        {
            return head->next;
        }
        int count=length-n-1;
        temp=head;
        for(int i=0;i<count;i++)
        {
            temp=temp->next;
        }
        temp->next=temp->next->next;
        return head;

    }
};
