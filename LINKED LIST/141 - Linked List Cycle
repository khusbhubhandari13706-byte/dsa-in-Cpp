/*
-----------------------------------------
LeetCode 141 - Linked List Cycle

Pattern:Fast & Slow Pointers (Floyd's Cycle Detection)

Approach:
1. Use two pointers: slow and fast.
2. Slow moves one step at a time.
3. Fast moves two steps at a time.
4. If a cycle exists, slow and fast will eventually meet.
5. If fast reaches NULL, there is no cycle.

Time Complexity:O(n)
Space Complexity:O(1)

Key Learning:
Fast & slow pointers can detect a cycle without using extra memory.
-----------------------------------------
*/

class Solution {
public:
    bool hasCycle(ListNode *head) {
        ListNode *slow=head;
        ListNode *fast=head;
        while(fast!=NULL && fast->next!=NULL)
        {
            slow=slow->next;
            fast=fast->next->next;
            if(slow==fast) return true;
        }
        return false;
    }
};
